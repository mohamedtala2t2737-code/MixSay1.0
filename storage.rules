rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAtLeastThirteen(birthDate) {
      let today = request.time.date();
      let birthday = birthDate.date();
      let years = today.year() - birthday.year();
      return years > 13
        || (
          years == 13
          && (
            birthday.month() < today.month()
            || (
              birthday.month() == today.month()
              && birthday.day() <= today.day()
            )
          )
        );
    }

    function eligibleUser() {
      let user = firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      );
      return user.data.birthDate is timestamp
        && isAtLeastThirteen(user.data.birthDate);
    }

    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && eligibleUser();
    }

    function isConversationMember(conversationId) {
      return verifiedUser()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.members;
    }

    // Byte ceilings for a chat upload, keyed by content type because a Storage
    // request cannot see the Firestore message it belongs to. Matches
    // ChatFeatures and the chatMediaSizeIsAllowed() check in firestore.rules.
    function chatUploadIsAllowed() {
      let size = request.resource.size;
      let type = request.resource.contentType;
      return (
        (type.matches('image/.*') && size < 5 * 1024 * 1024)
        || (type.matches('video/.*') && size < 25 * 1024 * 1024)
        || (type.matches('audio/.*') && size < 5 * 1024 * 1024)
        || (
          (
            type.matches('application/.*')
            || type.matches('text/.*')
          )
          && size < 10 * 1024 * 1024
        )
      );
    }

    match /chats/{conversationId}/{senderId}/{fileName} {
      allow read: if isConversationMember(conversationId);
      allow create, update: if isConversationMember(conversationId)
        && request.auth.uid == senderId
        && chatUploadIsAllowed();
      allow delete: if isConversationMember(conversationId)
        && request.auth.uid == senderId;
    }

    // Feed media: FeedRepository.uploadPostMedia writes posts/{uid}/{file}.
    // Anyone signed in may view it (the feed is public), but a user can only
    // replace or delete media under their own id.
    match /posts/{userId}/{fileName} {
      allow read: if verifiedUser();
      allow create, update: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
        );
      allow delete: if verifiedUser() && request.auth.uid == userId;
    }

    // Story media: StoryRepository.createStory writes stories/{uid}/{file}.
    // Images only, so the viewer never needs a video pipeline.
    match /stories/{userId}/{fileName} {
      allow read: if verifiedUser();
      allow create: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if verifiedUser() && request.auth.uid == userId;
    }
  }
}
