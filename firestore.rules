rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAtLeastThirteen(birthDate) {
      // Rules validate the submitted calendar date; they cannot verify identity.
      let today = request.time.date();
      let birthday = birthDate.date();
      let years = today.year() - birthday.year();
      return years > 13
        || (
          years == 13
          && (
            birthday.month() < today.month()
            || (
              birthday.month() == today.month()
              && birthday.day() <= today.day()
            )
          )
        );
    }

    function hasEligibleBirthDate(birthDate) {
      return birthDate is timestamp && isAtLeastThirteen(birthDate);
    }

    function eligibleUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && hasEligibleBirthDate(
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.birthDate
        );
    }

    function verifiedUser() {
      return eligibleUser() && request.auth.token.email_verified == true;
    }

    function eligibleUserAfterWrite(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return existsAfter(userPath)
        && hasEligibleBirthDate(getAfter(userPath).data.birthDate);
    }

    function isConversationMember(conversationId) {
      return verifiedUser()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.members;
    }

    // The other participant of a two-member conversation.
    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    // ------------------------------------------------------------ chat media
    // Kept in step with ChatMessageType and ChatFeatures in Dart: a message the
    // server does not recognise is refused on write, never on read.
    function chatMessageTypes() {
      return ['text', 'image', 'video', 'file', 'voice', 'sticker', 'gif'];
    }

    // Byte ceilings per type. The app refuses an oversized file before it
    // uploads; this is the backstop for anything that reaches the server.
    function chatMediaSizeIsAllowed(type, size) {
      return type == 'image'
        ? size < 5 * 1024 * 1024
        : type == 'video'
          ? size < 25 * 1024 * 1024
          : type == 'file'
            ? size < 10 * 1024 * 1024
            : type == 'voice'
              ? size < 5 * 1024 * 1024
              : true;
    }

    // The Storage layout for chat uploads: chats/{conversationId}/{senderId}/file
    // Nobody may point a message at another pair's folder or another sender's.
    function chatUploadPathIsMine(media, conversationId) {
      let parts = media.split('/');
      return parts.size() == 4
        && parts[0] == 'chats'
        && parts[1] == conversationId
        && parts[2] == request.auth.uid;
    }

    function chatMessageCarriesWhatItClaims(message, type, conversationId) {
      let media = message.mediaUrl;
      return type == 'text'
        ? media == null && message.content.size() > 0
        : type == 'sticker'
          ? (
            media == null
            && message.get('stickerId', null) is string
            || (
              media is string
              && chatUploadPathIsMine(media, conversationId)
            )
          )
          : type == 'gif'
            ? media is string && media.matches('https://.*')
            : media is string
              && chatUploadPathIsMine(media, conversationId);
    }

    function chatReplyIsValid(reply) {
      return reply.keys().hasOnly(['messageId', 'senderId', 'content', 'type'])
        && reply.keys().hasAll(['messageId', 'senderId', 'content', 'type'])
        && reply.messageId is string
        && reply.messageId.size() <= 60
        && reply.senderId is string
        && reply.senderId.size() <= 60
        && reply.content is string
        && reply.content.size() <= 300
        && reply.type in chatMessageTypes();
    }

    // A plain text message writes exactly the seven fields the app has always
    // written, so sending keeps working against rules that are already
    // deployed. Every field here beyond those seven belongs to a feature that
    // needs this version published first.
    function chatMessageFields() {
      return [
        'senderId',
        'recipientId',
        'clientId',
        'content',
        'mediaUrl',
        'createdAt',
        'status',
        'type',
        'thumbUrl',
        'fileName',
        'fileSize',
        'durationMs',
        'stickerId',
        'replyTo',
        'deletedFor',
        'deletedForEveryone',
        'forwarded'
      ];
    }

    function chatOptionalFieldsAreValid(message, type, conversationId) {
      let fileSize = message.get('fileSize', null);
      let fileName = message.get('fileName', null);
      let durationMs = message.get('durationMs', null);
      let thumbUrl = message.get('thumbUrl', null);
      let stickerId = message.get('stickerId', null);
      return (
        fileSize == null
        || (
          fileSize is int
          && fileSize >= 0
          && chatMediaSizeIsAllowed(type, fileSize)
        )
      )
      && (
        fileName == null
        || (
          fileName is string
          && fileName.size() > 0
          && fileName.size() <= 255
        )
      )
      && (
        durationMs == null
        || (durationMs is int && durationMs >= 0 && durationMs <= 600000)
      )
      && (
        thumbUrl == null
        || (
          thumbUrl is string
          && (
            thumbUrl.matches('https://.*')
            || chatUploadPathIsMine(thumbUrl, conversationId)
          )
        )
      )
      && (
        stickerId == null
        || (
          stickerId is string
          && stickerId.size() > 0
          && stickerId.size() <= 120
        )
      );
    }

    function chatMessageIsValidOnCreate(message, conversationId) {
      let type = message.get('type', 'text');
      let replyTo = message.get('replyTo', null);
      let deletedFor = message.get('deletedFor', null);
      let deletedForEveryone = message.get('deletedForEveryone', null);
      let forwarded = message.get('forwarded', null);
      return message.content is string
        && message.content.size() <= 4000
        && (message.mediaUrl is string || message.mediaUrl == null)
        && type in chatMessageTypes()
        && chatMessageCarriesWhatItClaims(message, type, conversationId)
        && chatOptionalFieldsAreValid(message, type, conversationId)
        && (replyTo == null || chatReplyIsValid(replyTo))
        // A brand new message is visible to both sides. Hiding is an update, so
        // a sender can never quietly deliver something the receiver cannot see.
        && deletedFor == null
        && (deletedForEveryone == null || deletedForEveryone == false)
        // The forwarded label is a plain flag a copy arrives with. It buys
        // nothing: chatMessageCarriesWhatItClaims above still refuses a message
        // that points at another chat's file, so claiming to be a copy cannot
        // smuggle in someone else's media path. Only a create can set it — the
        // update branches never list it among the keys they accept.
        && (forwarded == null || forwarded is bool);
    }

    // sent -> delivered -> read, and never back.
    function chatStatusMovesForward(before, after) {
      return (
        (before == 'sent' && (after == 'delivered' || after == 'read'))
        || (before == 'delivered' && after == 'read')
      );
    }

    // A hide-from-me write may add exactly the writer and never anybody else,
    // it may never remove a hide that is already there, and it may not be a
    // no-op (re-hiding a message the writer has already hidden changes nothing,
    // so ChatRepository never sends it and the rules refuse it). Set equality
    // with `==` is not available here, so the change is described by its counts.
    function chatDeletedForAddsOnlyMe(before, after) {
      // Rules functions have no early return, so a value that is not a list is
      // swapped for an empty one and rejected by the type test below.
      let beforeList = (before is list) ? before : [];
      let afterList = (after is list) ? after : [];
      let added = afterList.toSet().difference(beforeList.toSet());
      let removed = beforeList.toSet().difference(afterList.toSet());
      // Sets have no `has()` here, so the writer is located with list
      // membership: one new entry that is not yet present must be the writer.
      return before is list
        && after is list
        && removed.size() == 0
        && added.size() == 1
        && request.auth.uid in after
        && !(request.auth.uid in before);
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Created once at sign-up. Not updatable afterwards (birthDate must not
      // be editable). If an "edit private data" screen is added later, relax
      // the update rule for specific fields only.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['birthDate', 'createdAt'])
        && request.resource.data.birthDate is timestamp
        && isAtLeastThirteen(request.resource.data.birthDate)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;

      match /deviceTokens/{token} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(
            ['token', 'platform', 'updatedAt']
          )
          && request.resource.data.token is string
          && request.resource.data.platform is string
          && request.resource.data.updatedAt is timestamp;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // ------------------------------------------------------------- follows
      // A follow is two mirrored rows written by the follower in one batch:
      // `users/{target}/followers/{me}` and `users/{me}/following/{target}`.
      // Mirroring keeps both directions a plain subcollection read instead of a
      // `where` query across a global collection, which would need a composite
      // index and would let anyone stream somebody else's whole graph.
      // The row id is the person the row is ABOUT, so the key and the `userId`
      // field have to agree and nobody can write a row for anybody but
      // themselves.
      match /followers/{followerId} {
        allow create: if verifiedUser()
          && request.auth.uid == followerId
          && request.auth.uid != userId
          && request.resource.data.keys().hasOnly(['userId', 'followedAt'])
          && request.resource.data.userId == followerId
          && request.resource.data.followedAt == request.time;
        // The graph is public the way the feed is: any verified user may see
        // who follows whom. Reading rows one by one is unlimited, listing them
        // is capped at FollowRepository.countProbe, which is how the app counts
        // followers without a count() aggregate (an aggregate carries no limit,
        // so it cannot be bounded by `request.query.limit`).
        allow get: if verifiedUser();
        allow list: if verifiedUser() && request.query.limit <= 201;
        // Only the follower can end a follow; the author of a profile cannot
        // erase someone's own row.
        allow delete: if verifiedUser() && request.auth.uid == followerId;
        allow update: if false;
      }

      match /following/{targetId} {
        allow create: if verifiedUser()
          && request.auth.uid == userId
          && request.auth.uid != targetId
          && request.resource.data.keys().hasOnly(['userId', 'followedAt'])
          && request.resource.data.userId == targetId
          && request.resource.data.followedAt == request.time;
        allow get: if verifiedUser();
        allow list: if verifiedUser() && request.query.limit <= 201;
        allow delete: if verifiedUser() && request.auth.uid == userId;
        allow update: if false;
      }

      // ----------------------------------------------------- saved stickers
      // A save is a bookmark, not a copy: the row holds which pack and which
      // sticker, and the picture still comes out of the assets this build
      // ships. So a row can name a sticker that does not exist, but it can
      // never carry bytes, a URL, or a path into somebody's storage.
      // The id is both halves joined with `_`, and neither half may hold `_`,
      // so one sticker has exactly one row no matter how often it is tapped,
      // and no pair of halves can be re-split into a different savedId.
      // Neither half is free-form either: the charset is the one
      // ChatStickerPack's ids are written with, so a made-up document cannot
      // look like a pack the app knows.
      match /savedStickers/{savedId} {
        allow get: if signedIn() && request.auth.uid == userId;
        // The app reads one page of 200 at a time, which is also its ceiling:
        // rules cannot count a collection, so SavedStickerRepository.count()
        // probes with limit(200) and refuses a 201st save. An aggregate carries
        // no limit, so count() could not be bounded here even if it existed.
        // Capping the list is what stops a stranger's tokenless read from
        // dumping every bookmark.
        allow list: if signedIn()
          && request.auth.uid == userId
          && request.query.limit <= 200;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(
            ['packId', 'sticker', 'savedAt']
          )
          && request.resource.data.packId.matches('^[a-z0-9-]{1,40}$')
          && request.resource.data.sticker.matches('^[a-z0-9-]{1,40}$')
          && savedId ==
            request.resource.data.packId
            + '_'
            + request.resource.data.sticker
          && request.resource.data.savedAt == request.time;
        // Re-saving a sticker the user already has is a no-op the row id makes
        // impossible to duplicate, so the only thing a second tap may change is
        // the timestamp. Without this the row would be an update, `update: if
        // false` would refuse it, and the app would report an error for a save
        // that had already worked.
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['savedAt']
          )
          && request.resource.data.savedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    //------------------------------------------------------- publicProfiles
    match /publicProfiles/{userId} {
      allow get: if verifiedUser();
      // The app always searches with limit(20). This blocks bulk scraping.
      allow list: if verifiedUser() && request.query.limit <= 20;
      allow create: if signedIn()
        && request.auth.uid == userId
        && eligibleUserAfterWrite(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'username',
          'usernameLowercase',
          'fullName',
          'avatarUrl',
          'bio',
          'createdAt'
        ])
        && request.resource.data.id == userId
        && request.resource.data.username is string
        && request.resource.data.username.matches(
          '^[a-z0-9.]{4,24}$'
        )
        && request.resource.data.usernameLowercase is string
        && request.resource.data.usernameLowercase.matches(
          '^[a-z0-9.]{4,24}$'
        )
        && request.resource.data.usernameLowercase
          == request.resource.data.username.lower()
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 80
        && (
          request.resource.data.avatarUrl is string
          || request.resource.data.avatarUrl == null
        )
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && request.resource.data.createdAt is timestamp
        // The username must be claimed by the same user in the same commit
        // (prevents creating a profile with someone else's username).
        && getAfter(
          /databases/$(database)/documents/usernames/$(
            request.resource.data.usernameLowercase
          )
        ).data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid == userId
        && eligibleUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'avatarUrl',
          'bio'
        ])
        && request.resource.data.id == resource.data.id
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLowercase
          == resource.data.usernameLowercase
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 300
        && (
          request.resource.data.avatarUrl is string
          || request.resource.data.avatarUrl == null
        );
      allow delete: if false;
    }

    // ------------------------------------------------------------ usernames
    match /usernames/{username} {
      // Needed unauthenticated: the sign-up form checks availability
      // before the account exists.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && username.matches('^[a-z0-9.]{4,24}$')
        && request.resource.data.uid == request.auth.uid
        && eligibleUserAfterWrite(request.auth.uid)
        // The claim must match the profile created in the same commit
        // (prevents squatting several usernames).
        && getAfter(
          /databases/$(database)/documents/publicProfiles/$(request.auth.uid)
        ).data.usernameLowercase == username;
      allow update, delete: if false;
    }

    // -------------------------------------------------------- conversations
    function participantProfileMatches(userId, participant) {
      let profile = get(
        /databases/$(database)/documents/publicProfiles/$(userId)
      ).data;
      return participant.keys().hasOnly(['username', 'fullName', 'avatarUrl'])
        && participant.username == profile.username
        && participant.fullName == profile.fullName
        && participant.avatarUrl == profile.avatarUrl;
    }

    match /conversations/{conversationId} {
      // `resource == null` is required: the app calls doc(id).get() BEFORE
      // creating the conversation. Without it the first conversation between
      // two users is always denied.
      allow get: if verifiedUser()
        && (resource == null || request.auth.uid in resource.data.members);
      allow list: if verifiedUser()
        // ChatRepository.watchConversations orders by lastMessageAt and caps the
        // window at 50, so a member cannot stream their whole conversation list
        // or the list of an account they were invited into.
        && request.query.limit <= 50
        && request.auth.uid in resource.data.members;

      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly([
          'members',
          'participants',
          'lastMessageContent',
          'lastMessageAt',
          'unreadCounts',
          'createdAt',
          'lastMessageType',
          'lastSenderId',
          'typing'
        ])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        // Same id formula as ChatRepository.getOrCreateConversation.
        && conversationId == string(request.resource.data.members[0].size())
          + '_' + request.resource.data.members[0]
          + request.resource.data.members[1]
        && request.resource.data.lastMessageContent == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.get('lastMessageType', null) == null
        && request.resource.data.get('lastSenderId', null) == null
        // A brand new thread has nobody typing. The map appears with the first
        // typing write and is then kept to one boolean per member.
        && (
          request.resource.data.get('typing', null) == null
          || (
            request.resource.data.typing is map
            && request.resource.data.typing.keys().hasOnly(
              request.resource.data.members
            )
            && request.resource.data.typing.values().hasOnly([false])
          )
        )
        && request.resource.data.createdAt is timestamp
        && request.resource.data.unreadCounts is map
        && request.resource.data.unreadCounts.keys().hasOnly(
          request.resource.data.members
        )
        && request.resource.data.unreadCounts[
          request.resource.data.members[0]
        ] == 0
        && request.resource.data.unreadCounts[
          request.resource.data.members[1]
        ] == 0
        && request.resource.data.participants is map
        && request.resource.data.participants.keys().hasOnly(
          request.resource.data.members
        )
        && request.resource.data.participants.keys().hasAll(
          request.resource.data.members
        )
        && participantProfileMatches(
          request.resource.data.members[0],
          request.resource.data.participants[
            request.resource.data.members[0]
          ]
        )
        && participantProfileMatches(
          request.resource.data.members[1],
          request.resource.data.participants[
            request.resource.data.members[1]
          ]
        );

      allow update: if verifiedUser()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageContent',
          'lastMessageAt',
          'unreadCounts',
          'lastMessageType',
          'lastSenderId',
          'typing'
        ])
        && (
          request.resource.data.lastMessageContent == null
          || (
            request.resource.data.lastMessageContent is string
            && request.resource.data.lastMessageContent.size() <= 4000
          )
        )
        && (
          request.resource.data.lastMessageAt == null
          || request.resource.data.lastMessageAt is timestamp
        )
        // The preview label and its author move together with the preview, and
        // only to something the app can actually write.
        && (
          request.resource.data.get('lastMessageType', null) == null
          || request.resource.data.lastMessageType in chatMessageTypes()
        )
        && (
          request.resource.data.get('lastSenderId', null) == null
          || request.resource.data.lastSenderId in resource.data.members
        )
        // Typing is one boolean per member and a member may only move their own
        // flag, so nobody can fake "the other side is typing" or silence it.
        && (
          request.resource.data.get('typing', null) == null
          || (
            request.resource.data.typing is map
            && request.resource.data.typing.keys().hasOnly(
              resource.data.members
            )
            && request.resource.data.typing.values().hasOnly([true, false])
            && (
              resource.data.get('typing', null) == null
              || request.resource.data.typing.get(
                otherMember(resource.data.members),
                false
              ) == resource.data.typing.get(
                otherMember(resource.data.members),
                false
              )
            )
          )
        )
        && request.resource.data.unreadCounts.keys().hasOnly(
          resource.data.members
        )
        // I can only lower MY unread counter (mark as read)...
        && request.resource.data.unreadCounts[request.auth.uid]
          <= resource.data.unreadCounts.get(request.auth.uid, 0)
        // ...and only raise the OTHER user's counter by at most 1 per write.
        && request.resource.data.unreadCounts[
          otherMember(resource.data.members)
        ] >= resource.data.unreadCounts.get(
          otherMember(resource.data.members), 0
        )
        && request.resource.data.unreadCounts[
          otherMember(resource.data.members)
        ] <= resource.data.unreadCounts.get(
          otherMember(resource.data.members), 0
        ) + 1;
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isConversationMember(conversationId);
        // watchRecentMessages uses limitToLast(100) and getMessages limit(30);
        // the cap stops a member from dumping a whole thread in one request.
        allow list: if isConversationMember(conversationId)
          && request.query.limit <= 100;

        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasAll([
            'senderId',
            'clientId',
            'content',
            'mediaUrl',
            'createdAt',
            'status',
            // Required, not optional: the cheap read-receipt and delivered
            // queries filter on it, so a message without it can never be
            // marked read.
            'recipientId'
          ])
          && request.resource.data.keys().hasOnly(chatMessageFields())
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.recipientId in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.members
          && request.resource.data.clientId == messageId
          && request.resource.data.createdAt is timestamp
          && request.resource.data.status == 'sent'
          && chatMessageIsValidOnCreate(request.resource.data, conversationId);

        // Status only moves forward: sent -> delivered -> read, and it stays the
        // only thing the receiving side may write, so a reader cannot rewrite a
        // message they never sent.
        allow update: if isConversationMember(conversationId) && (
          (
            resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status']
            )
            && chatStatusMovesForward(
              resource.data.status,
              request.resource.data.status
            )
          )
          // "Delete for me": either side can hide a message from their own view,
          // and only from themselves.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deletedFor'
            ])
            && chatDeletedForAddsOnlyMe(
              resource.data.get('deletedFor', []),
              request.resource.data.deletedFor
            )
          )
          // "Delete for everyone": the sender only, at most once, and nothing
          // else about the message changes.
          || (
            resource.data.senderId == request.auth.uid
            && resource.data.get('deletedForEveryone', null) != true
            && request.resource.data.get('deletedForEveryone', null) == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['deletedForEveryone']
            )
          )
        );
        // Only the sender may remove a message, never the recipient. The app
        // offers this for queued/failed sends: without it, a send that quietly
        // reached Firestore while the local queue still said "failed" could
        // never be got rid of and would reappear on the next sync.
        allow delete: if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // --------------------------------------------------------------- posts
    // A post copies its author's public profile so the feed needs no extra
    // reads. These checks make that copy match the real profile, which stops
    // a user from posting, liking or commenting under someone else's name.
    function profileCopyMatchesAuthor(userId, data) {
      let profile = get(
        /databases/$(database)/documents/publicProfiles/$(userId)
      ).data;
      return data.username == profile.username
        && data.fullName == profile.fullName
        && data.avatarUrl == profile.avatarUrl;
    }

    function usernameMatchesProfile(userId, username) {
      return username == get(
        /databases/$(database)/documents/publicProfiles/$(userId)
      ).data.username;
    }

    match /posts/{postId} {
      allow get: if verifiedUser();
      // The feed always paginates with limit(30); this blocks bulk scraping.
      allow list: if verifiedUser() && request.query.limit <= 30;

      allow create: if verifiedUser()
        && request.resource.data.authorId == request.auth.uid
        && profileCopyMatchesAuthor(
          request.auth.uid,
          request.resource.data
        )
        && request.resource.data.keys().hasOnly([
          'authorId',
          'username',
          'fullName',
          'avatarUrl',
          'caption',
          'mediaUrl',
          'mediaUrls',
          'mediaType',
          'likesCount',
          'commentsCount',
          'createdAt'
        ])
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2000
        && (
          request.resource.data.mediaUrl is string
          || request.resource.data.mediaUrl == null
        )
        && request.resource.data.mediaType in ['none', 'image', 'video']
        // Carousel media. Optional: posts written before it exist carry only
        // mediaUrl, and hasOnly never requires a key to be present.
        // The rules language has no list macro (`.all(...)` fails to compile in
        // the emulator), so only the first slide and the count are checked here
        // and FeedRepository validates every slide before it writes. The order
        // of these clauses matters: size() >= 1 must short-circuit before the
        // [0] lookups or an empty list becomes an evaluation error.
        && (
          !('mediaUrls' in request.resource.data)
          || (
            request.resource.data.mediaUrls is list
            && request.resource.data.mediaUrls.size() >= 1
            && request.resource.data.mediaUrls.size() <= 10
            && request.resource.data.mediaUrls[0] is string
            && request.resource.data.mediaUrls[0].size() > 0
            // Images never mix with a clip inside one post.
            && request.resource.data.mediaType == 'image'
            // The legacy pointer keeps naming the first slide, so readers that
            // only know mediaUrl still show a real image.
            && request.resource.data.mediaUrl
              == request.resource.data.mediaUrls[0]
          )
        )
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.createdAt == request.time
        // A post must carry text or media.
        && (
          request.resource.data.caption.size() > 0
          || request.resource.data.mediaUrl is string
        );

      // Denormalised counters only: one like or one comment moves exactly one
      // counter by one. Nothing else about a post is client-writable.
      allow update: if verifiedUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likesCount',
          'commentsCount'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().size() <= 1
        && request.resource.data.likesCount is int
        && request.resource.data.commentsCount is int
        && request.resource.data.likesCount >= 0
        && request.resource.data.commentsCount >= 0
        && (
          request.resource.data.likesCount - resource.data.likesCount == 1
          || resource.data.likesCount - request.resource.data.likesCount == 1
          || request.resource.data.likesCount == resource.data.likesCount
        )
        && (
          request.resource.data.commentsCount
            - resource.data.commentsCount == 1
          || resource.data.commentsCount
            - request.resource.data.commentsCount == 1
          || request.resource.data.commentsCount
            == resource.data.commentsCount
        );

      allow delete: if verifiedUser()
        && resource.data.authorId == request.auth.uid;

      // The document id is the liker's uid, which makes likes idempotent.
      match /likes/{likerId} {
        allow read: if verifiedUser() && request.auth.uid == likerId;
        allow create: if verifiedUser()
          && request.auth.uid == likerId
          && request.resource.data.keys().hasOnly([
            'authorId',
            'username',
            'createdAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && usernameMatchesProfile(likerId, request.resource.data.username)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if verifiedUser() && request.auth.uid == likerId;
      }

      match /comments/{commentId} {
        allow get: if verifiedUser();
        // Comment threads are always fetched with limit(50).
        allow list: if verifiedUser() && request.query.limit <= 50;
        allow create: if verifiedUser()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'authorId',
            'username',
            'content',
            'createdAt'
          ])
          && usernameMatchesProfile(
            request.auth.uid,
            request.resource.data.username
          )
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // --------------------------------------------------------------- stories
    // A story expires 24h after createdAt. Clients may only ever read it
    // forward in time because createdAt is pinned to request.time, so a fake
    // device clock cannot revive an old story or push one past the window.
    function storyAuthor(storyId) {
      return get(
        /databases/$(database)/documents/stories/$(storyId)
      ).data.authorId;
    }

    match /stories/{storyId} {
      allow get: if verifiedUser();
      // StoryRepository queries with limit(60); this blocks bulk scraping.
      allow list: if verifiedUser() && request.query.limit <= 60;

      allow create: if verifiedUser()
        && request.resource.data.authorId == request.auth.uid
        && profileCopyMatchesAuthor(
          request.auth.uid,
          request.resource.data
        )
        && request.resource.data.keys().hasOnly([
          'authorId',
          'username',
          'fullName',
          'avatarUrl',
          'mediaUrl',
          'createdAt'
        ])
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if verifiedUser()
        && resource.data.authorId == request.auth.uid;

      // Who watched one of my stories. `storyAuthor` reads the parent document,
      // so StoryRepository.deleteStory must clear the audience while the story
      // still exists: after the parent is gone every viewer write is refused.
      match /viewers/{viewerId} {
        allow create: if verifiedUser()
          && request.auth.uid == viewerId
          && request.auth.uid != storyAuthor(storyId)
          && request.resource.data.keys().hasOnly(['userId', 'viewedAt'])
          && request.resource.data.userId == viewerId
          && request.resource.data.viewedAt == request.time;
        // Only the author reads their audience, and always with limit(200).
        allow get: if verifiedUser()
          && request.auth.uid == storyAuthor(storyId);
        allow list: if verifiedUser()
          && request.auth.uid == storyAuthor(storyId)
          && request.query.limit <= 200;
        allow delete: if verifiedUser()
          && request.auth.uid == storyAuthor(storyId);
        allow update: if false;
      }
    }

    // ---------------------------------------------------------------- reports
    // Write-only from the app: a report is read in the Firebase console or by a
    // Cloud Function, never by a client. The document id is derived from the
    // reporter and the target, so tapping report twice on the same thing is an
    // impossible write instead of a flood of documents.
    match /reports/{reportId} {
      allow read, update, delete: if false;

      allow create: if verifiedUser()
        && reportId == request.auth.uid + '_' + request.resource.data.targetId
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'targetType',
          'targetId',
          'reason',
          'extraNote',
          'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['post', 'story']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 60
        // The sheet offers exactly these reasons, and nothing else.
        && request.resource.data.reason in [
          'spam',
          'harassment',
          'nudity',
          'violence',
          'misinformation',
          'other'
        ]
        && (
          !('extraNote' in request.resource.data)
          || (
            request.resource.data.extraNote is string
            && request.resource.data.extraNote.size() <= 300
          )
        )
        // The target must exist, and nobody may report their own content: get()
        // on a missing document yields no authorId, so both cases fall here.
        && (
          (
            request.resource.data.targetType == 'post'
            && get(
              /databases/$(database)/documents/posts/$(
                request.resource.data.targetId
              )
            ).data.authorId != request.auth.uid
          )
          || (
            request.resource.data.targetType == 'story'
            && get(
              /databases/$(database)/documents/stories/$(
                request.resource.data.targetId
              )
            ).data.authorId != request.auth.uid
          )
        )
        && request.resource.data.createdAt == request.time;
    }

    // --------------------------------------------------------- notifications
    // Notifications are written by Cloud Functions, which run with Admin
    // privileges and bypass these rules. A client may only read its own inbox
    // and mark its own entries as read.
    match /notifications/{notificationId} {
      allow get: if verifiedUser()
        && resource.data.recipientId == request.auth.uid;
      allow list: if verifiedUser()
        // The app queries recipientId == me with limit(50).
        && request.query.limit <= 50
        && resource.data.recipientId == request.auth.uid;

      allow update: if verifiedUser()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead'])
        && request.resource.data.isRead == true;

      allow create, delete: if false;
    }
  }
}
